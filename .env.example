APP_ENV=development
INSTANCE_ID=default

LOG_LEVEL=info
LOG_FORMAT=json

HTTP_ADDR=:3000
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Clave de la API (distinta de OPENAI_API_KEY)
API_KEY=change-me-api-key
CORS_ALLOWED_ORIGINS=*

# Panel /admin (UI embebida en botd)
ADMIN_ENABLED=true
# En desarrollo vacío => usa API_KEY. En producción vacío => panel deshabilitado.
ADMIN_PASSWORD=
# Nombre que firma los mensajes manuales enviados desde el panel (p. ej. el operador)
ADMIN_OPERATOR_NAME=
# Clave HMAC de la cookie de sesión (vacío => usa ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL=12h

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_EMBED_MODEL=text-embedding-3-small
RAG_THRESHOLD=0.78

# Assets (seed: datos iniciales sembrados en la BD)
PROMPTS_DIR=data/seeds/prompts
DATA_DIR=data/seeds

DATABASE_URL=postgres://aibotia:aibotia@localhost:5432/aibotia?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Solo para la migración de datos desde la app Node/MariaDB (cmd/migrate-data)
LEGACY_DATABASE_URL=

AUTO_MIGRATE=true

# WhatsApp
WHATSAPP_ENABLED=true
# Por defecto reutiliza DATABASE_URL
WHATSAPP_STORE_DSN=

HOURS_TO_ACTIVE=168
BUFFER_MIN_MS=1000
BUFFER_MAX_MS=15000

# Recordatorios de cita
REMINDER_CRON=*/10 * * * *
REMINDER_TEMPLATE=📅 Hola {name}, tienes una cita programada el {date}. ¡No olvides asistir!

# Anti-spam (ventana deslizante por usuario)
SPAM_LIMIT=5
SPAM_WINDOW=60s

# Ubicación del Studio (opcional; para la acción send_location)
LOCATION_NAME=
LOCATION_ADDRESS=
LOCATION_LAT=0
LOCATION_LNG=0

# Formulario de contacto de la landing (/)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=starttls
CONTACT_TO=info@nestorpons.com

# Captcha Cloudflare Turnstile (formulario de contacto)
# SITE_KEY: clave pública del widget. SECRET: clave secreta para validar en servidor
# (si SECRET queda vacío el widget se muestra pero no se valida).
TURNSTILE_SITE_KEY=0x4AAAAAAFsVda3EWc4d4Qy0
TURNSTILE_SECRET=

# Bot de pruebas (cmd/tester)
TEST_TARGET=
TESTER_DATABASE_URL=
TESTER_CASES_DIR=data/test/cases
BOT_API_BASE=http://localhost:3000
# Vacío => usa API_KEY
BOT_API_KEY=

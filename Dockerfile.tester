# syntax=docker/dockerfile:1

# Imagen del bot de pruebas (cliente de WhatsApp que conversa con el chatbot).
FROM golang:1.27-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w" -o /out/tester ./cmd/tester

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 10002 tester
WORKDIR /app
COPY --from=build /out/tester /usr/local/bin/tester
COPY data ./data
RUN mkdir -p /app/reports && chown tester:tester /app/reports
USER tester

ENV TZ=Europe/Madrid \
    TESTER_REPORT_DIR=/app/reports

ENTRYPOINT ["tester"]

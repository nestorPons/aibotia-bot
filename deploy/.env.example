# Producción (VPS + Traefik). Copiar a deploy/.env y rellenar secretos.
APP_ENV=production
INSTANCE_ID=default
LOG_LEVEL=info
LOG_FORMAT=json
TZ=Europe/Madrid

# HTTP solo en loopback; Traefik publica el dominio.
HTTP_PORT=3000

# Clave de la API (distinta de OPENAI_API_KEY)
API_KEY=
CORS_ALLOWED_ORIGINS=https://aibotia.com,https://www.aibotia.com

# Panel /admin
ADMIN_ENABLED=true
ADMIN_PASSWORD=
ADMIN_OPERATOR_NAME=Operador
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL=12h

# PostgreSQL
POSTGRES_USER=aibotia
POSTGRES_PASSWORD=
POSTGRES_DB=aibotia

# IA
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_EMBED_MODEL=text-embedding-3-small
RAG_THRESHOLD=0.78

# WhatsApp
WHATSAPP_ENABLED=true
HOURS_TO_ACTIVE=168
BUFFER_MIN_MS=1000
BUFFER_MAX_MS=15000
REMINDER_CRON=*/10 * * * *
SPAM_LIMIT=5
SPAM_WINDOW=60s

# Ubicación (acción send_location)
LOCATION_NAME=
LOCATION_ADDRESS=
LOCATION_LAT=0
LOCATION_LNG=0

# Formulario de contacto
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=starttls
CONTACT_TO=info@nestorpons.com

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Bot de pruebas (perfil tester). TEST_TARGET = número del chatbot.
TEST_TARGET=
TESTER_DB=aibotia_tester
TESTER_CASES_DIR=data/test/cases
BOT_API_BASE=http://botd:3000
